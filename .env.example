# Copy to .env for local development. Never commit real credentials.
OPENAI_API_KEY=
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image
XAI_IMAGE_PRICE=0.02
XAI_IMAGE_EDIT_PRICE=0.022
ARTWORK_STORAGE_DIR=.artifacts
OPENAI_REASONING_MODEL=gpt-4o-mini
# Maximum time allowed for one structured reasoning request, in seconds.
OPENAI_REASONING_TIMEOUT_SECONDS=420
# Vision detail for Luna artwork review: high is recommended for merchandise text.
OPENAI_IMAGE_DETAIL=high
OPENAI_INPUT_PRICE_PER_MILLION=0.15
OPENAI_OUTPUT_PRICE_PER_MILLION=0.60
OPENAI_WEB_SEARCH_PRICE_PER_CALL=0.01
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=merchandise_discovery
MVP_MAX_STAGE_ATTEMPTS=3
# The current client demo intentionally stops after Stage 1.
MVP_STOP_AFTER_STAGE=1
# Keep fixture mode while developing. Set to live only when you intend to spend API credits.
MVP_PROVIDER_MODE=fixture
