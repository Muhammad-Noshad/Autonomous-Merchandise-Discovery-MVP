# Copy to .env for local development. Never commit real credentials.
OPENAI_API_KEY=
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image
XAI_IMAGE_PRICE=0.02
OPENAI_REASONING_MODEL=gpt-4o-mini
OPENAI_INPUT_PRICE_PER_MILLION=0.15
OPENAI_OUTPUT_PRICE_PER_MILLION=0.60
MONGODB_URI=
MONGODB_DATABASE=merchandise_discovery
MVP_MAX_STAGE_ATTEMPTS=3
# Keep fixture mode while developing. Set to live only when you intend to spend API credits.
MVP_PROVIDER_MODE=fixture
